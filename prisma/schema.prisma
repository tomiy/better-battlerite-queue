// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
    output   = "../.prisma"
}

datasource db {
    provider = "sqlite"
    url      = env("DATABASE_URL")
}

model Server {
    id        Int      @id @default(autoincrement())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    discordId String @unique

    categoryChannelId     String?
    botCommandsChannelId  String?
    queueChannelId        String?
    matchHistoryChannelId String?

    botModRoleId     String?
    registeredRoleId String?
    matchRoleId      String?
    queueRoleId      String?

    serverGames ServerGame[]
}

model Game {
    id        Int      @id @default(autoincrement())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    name String @unique

    terrains   Terrain[]
    characters Character[]

    serverGames ServerGame[]
}

model ServerGame {
    id        Int      @id @default(autoincrement())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    game   Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
    gameId Int

    server   Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
    serverId Int

    regions  ServerGameRegion[]
    profiles ServerGameProfile[]

    gameModes GameMode[]

    @@unique([gameId, serverId])
}

model ServerGameRegion {
    id        Int      @id @default(autoincrement())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    name String

    serverGame   ServerGame @relation(fields: [serverGameId], references: [id], onDelete: Cascade)
    serverGameId Int

    profileRegions ServerGameProfileRegion[]

    @@unique([name, serverGameId])
}

model ServerGameProfile {
    id        Int      @id @default(autoincrement())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    discordId String

    inGameName  String
    description String?
    restricted  Boolean @default(false)

    serverGame   ServerGame @relation(fields: [serverGameId], references: [id], onDelete: Cascade)
    serverGameId Int

    regions      ServerGameProfileRegion[]
    matchPlayers MatchPlayer[]

    queueEntries QueueEntry[]

    matchDraftActions MatchDraftAction[]

    ratings Rating[]

    @@unique([discordId, serverGameId])
}

model Rating {
    id        Int      @id @default(autoincrement())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    elo Int @default(1000)

    gameMode   GameMode @relation(fields: [gameModeId], references: [id], onDelete: Cascade)
    gameModeId Int

    serverGameProfile   ServerGameProfile @relation(fields: [serverGameProfileId], references: [id], onDelete: Cascade)
    serverGameProfileId Int

    @@unique([gameModeId, serverGameProfileId])
}

model ServerGameProfileRegion {
    id        Int      @id @default(autoincrement())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    profile   ServerGameProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
    profileId Int

    serverGameRegion   ServerGameRegion @relation(fields: [serverGameRegionId], references: [id], onDelete: Cascade)
    serverGameRegionId Int

    @@unique([profileId, serverGameRegionId])
}

model Terrain {
    id        Int      @id @default(autoincrement())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    name String

    game   Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
    gameId Int

    gameModeTerrains GameModeTerrain[]

    @@unique([name, gameId])
}

model Character {
    id        Int      @id @default(autoincrement())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    name String

    game   Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
    gameId Int

    gameModeCharacters GameModeCharacter[]

    @@unique([name, gameId])
}

model GameMode {
    id        Int      @id @default(autoincrement())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    name           String
    teamCount      Int
    queueable      Boolean @default(false)
    queueMessageId String?

    serverGame   ServerGame @relation(fields: [serverGameId], references: [id], onDelete: Cascade)
    serverGameId Int

    draftSequence DraftSequence?

    terrains   GameModeTerrain[]
    characters GameModeCharacter[]

    queueEntries QueueEntry[]

    matches Match[]
    ratings Rating[]

    @@unique([name, serverGameId])
}

model DraftSequence {
    id        Int      @id @default(autoincrement())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    type     DraftSequenceType
    teamSize Int

    gameMode   GameMode @relation(fields: [gameModeId], references: [id], onDelete: Cascade)
    gameModeId Int      @unique

    steps DraftStep[]
}

model DraftStep {
    id        Int      @id @default(autoincrement())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    type  DraftStepType
    order Int

    draftSequence   DraftSequence @relation(fields: [draftSequenceId], references: [id], onDelete: Cascade)
    draftSequenceId Int
}

model QueueEntry {
    id        Int      @id @default(autoincrement())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    gameMode   GameMode @relation(fields: [gameModeId], references: [id], onDelete: Cascade)
    gameModeId Int

    serverGameProfile   ServerGameProfile @relation(fields: [serverGameProfileId], references: [id], onDelete: Cascade)
    serverGameProfileId Int

    @@unique([gameModeId, serverGameProfileId])
}

model GameModeTerrain {
    id        Int      @id @default(autoincrement())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    weight Int @default(100)

    terrain   Terrain @relation(fields: [terrainId], references: [id], onDelete: Cascade)
    terrainId Int

    gameMode   GameMode @relation(fields: [gameModeId], references: [id], onDelete: Cascade)
    gameModeId Int

    matches           Match[]
    matchDraftActions MatchDraftAction[]

    @@unique([terrainId, gameModeId])
}

model GameModeCharacter {
    id        Int      @id @default(autoincrement())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    enabled      Boolean @default(true)
    restrictions String?

    character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
    characterId Int

    gameMode   GameMode @relation(fields: [gameModeId], references: [id], onDelete: Cascade)
    gameModeId Int

    matchDraftActions MatchDraftAction[]

    @@unique([characterId, gameModeId])
}

model Match {
    id        Int      @id @default(autoincrement())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    lobbyCode String?

    state MatchState

    historyMessageId String?

    winningTeam Int?

    gameMode   GameMode @relation(fields: [gameModeId], references: [id], onDelete: Cascade)
    gameModeId Int

    gameModeTerrain   GameModeTerrain? @relation(fields: [gameModeTerrainId], references: [id], onDelete: Cascade)
    gameModeTerrainId Int?

    teams MatchTeam[]
}

model MatchTeam {
    id        Int      @id @default(autoincrement())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    order Int

    draftChannelId String?
    draftMessageId String?

    match   Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
    matchId Int

    players MatchPlayer[]

    draftActions MatchDraftAction[]

    @@unique([matchId, order])
}

model MatchPlayer {
    id        Int      @id @default(autoincrement())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    captain Boolean @default(false)

    winReport  Int?
    dropReport Boolean @default(false)

    ratingChange Int @default(0)

    serverGameProfile   ServerGameProfile @relation(fields: [serverGameProfileId], references: [id], onDelete: Cascade)
    serverGameProfileId Int

    team   MatchTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
    teamId Int

    @@unique([serverGameProfileId, teamId])
}

model MatchDraftAction {
    id        Int      @id @default(autoincrement())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    type   DraftStepType
    order  Int
    global Boolean       @default(false)

    team   MatchTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
    teamId Int

    serverGameProfile   ServerGameProfile? @relation(fields: [serverGameProfileId], references: [id], onDelete: Cascade)
    serverGameProfileId Int?

    gameModeTerrain   GameModeTerrain? @relation(fields: [gameModeTerrainId], references: [id], onDelete: Cascade)
    gameModeTerrainId Int?

    gameModeCharacter   GameModeCharacter? @relation(fields: [gameModeCharacterId], references: [id], onDelete: Cascade)
    gameModeCharacterId Int?

    @@unique([teamId, order])
}

enum DraftSequenceType {
    SEQUENTIAL
    SIMULTANEOUS
}

enum DraftStepType {
    PLAYER_PICK
    TERRAIN_BAN
    TERRAIN_PICK
    CHARACTER_GLOBAL_BAN
    CHARACTER_GLOBAL_PICK
    CHARACTER_BAN
    CHARACTER_PICK
}

enum MatchState {
    NEW
    DRAFT
    ONGOING
    FINISHED
    DROPPED
}
